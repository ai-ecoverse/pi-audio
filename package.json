{
  "name": "@ai-ecoverse/pi-audio",
  "version": "0.0.0",
  "description": "Voice bindings for pi: speech-to-text, text-to-speech and realtime speech for pi-coding-agent plugins and slicc-agent",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/pi-audio.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/pi-audio",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./faux": {
      "types": "./dist/types/faux/index.d.ts",
      "default": "./dist/faux/index.js"
    },
    "./openai-realtime": {
      "types": "./dist/types/openai-realtime/index.d.ts",
      "default": "./dist/openai-realtime/index.js"
    },
    "./worklet": {
      "types": "./dist/types/worklet/convert.d.ts",
      "default": "./dist/worklet/convert.js"
    },
    "./openai": {
      "types": "./dist/types/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./xai": {
      "types": "./dist/types/xai/index.d.ts",
      "default": "./dist/xai/index.js"
    },
    "./elevenlabs": {
      "types": "./dist/types/elevenlabs/index.d.ts",
      "default": "./dist/elevenlabs/index.js"
    },
    "./mistral": {
      "types": "./dist/types/mistral/index.d.ts",
      "default": "./dist/mistral/index.js"
    },
    "./fish": {
      "types": "./dist/types/fish/index.d.ts",
      "default": "./dist/fish/index.js"
    },
    "./durable": {
      "types": "./dist/types/durable/index.d.ts",
      "default": "./dist/durable/index.js"
    },
    "./gemini-live": {
      "types": "./dist/types/gemini-live/index.d.ts",
      "default": "./dist/gemini-live/index.js"
    },
    "./elevenlabs-agents": {
      "types": "./dist/types/elevenlabs-agents/index.d.ts",
      "default": "./dist/elevenlabs-agents/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.21.1",
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "lefthook": "2.2.1",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-durable": {
      "optional": true
    }
  }
}
