{
  "name": "@ai-ecoverse/pi-audio",
  "version": "0.0.0",
  "description": "Voice bindings for pi: speech-to-text, text-to-speech and realtime speech for pi-coding-agent plugins and slicc-agent",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/pi-audio.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/pi-audio",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.21.0",
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.0.4",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "lefthook": "2.2.1",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.4"
  }
}
